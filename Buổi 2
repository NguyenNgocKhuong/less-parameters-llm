using System;
using System.Collections.Generic;
using System.Linq;

class Student
{
    public int Id { get; set; }
    public string Name { get; set; }
    public int Age { get; set; }

    public Student(int id, string name, int age)
    {
        Id = id;
        Name = name;
        Age = age;
    }
}

class Program
{
    static void Main(string[] args)
    {
        // Tạo danh sách học sinh
        List<Student> list = new List<Student>()
        {
            new Student(1, "An", 16),
            new Student(2, "Binh", 17),
            new Student(3, "Anh Khoa", 19),
            new Student(4, "Lan", 15),
            new Student(5, "Minh", 18)
        };

        // a. In danh sách toàn bộ học sinh
        Console.WriteLine("a. Danh sách học sinh:");
        foreach (var s in list)
        {
            Console.WriteLine($"Id: {s.Id}, Name: {s.Name}, Age: {s.Age}");
        }
        Console.WriteLine();

        // b. Tìm và in ra danh sách học sinh có tuổi từ 15 đến 18
        Console.WriteLine("b. Học sinh tuổi từ 15 đến 18:");
        var tuoi1518 = list.Where(s => s.Age >= 15 && s.Age <= 18);
        foreach (var s in tuoi1518)
        {
            Console.WriteLine($"{s.Name} - {s.Age}");
        }
        Console.WriteLine();

        // c. Tìm học sinh có tên bắt đầu bằng chữ 'A'
        Console.WriteLine("c. Học sinh có tên bắt đầu bằng chữ 'A':");
        var tenA = list.Where(s => s.Name.StartsWith("A"));
        foreach (var s in tenA)
        {
            Console.WriteLine($"{s.Name} - {s.Age}");
        }
        Console.WriteLine();

        // d. Tính tổng tuổi của tất cả học sinh
        int tongTuoi = list.Sum(s => s.Age);
        Console.WriteLine("d. Tổng tuổi của tất cả học sinh: " + tongTuoi);
        Console.WriteLine();

        // e. Tìm học sinh có tuổi lớn nhất
        int maxAge = list.Max(s => s.Age);
        var lonNhat = list.Where(s => s.Age == maxAge);
        Console.WriteLine("e. Học sinh có tuổi lớn nhất:");
        foreach (var s in lonNhat)
        {
            Console.WriteLine($"{s.Name} - {s.Age}");
        }
        Console.WriteLine();

        // f. Sắp xếp học sinh theo tuổi tăng dần
        Console.WriteLine("f. Danh sách học sinh sau khi sắp xếp theo tuổi tăng dần:");
        var sapXep = list.OrderBy(s => s.Age);
        foreach (var s in sapXep)
        {
            Console.WriteLine($"{s.Name} - {s.Age}");
        }
    }
}
